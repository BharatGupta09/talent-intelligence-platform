# Copy to .env.local and fill with your own values. Never commit the filled file.

# --- Neon PostgreSQL -------------------------------------------------
# These two MUST be the least-privilege `tip_app` role, never neondb_owner.
# Neon's owner role carries BYPASSRLS, which overrides row-level security
# unconditionally — connecting as the owner switches off every policy in
# db/migrations/0002_rls.sql silently. Run `npm run db:setup-role` and it
# rewrites both of these for you. See DEPLOY.md section 0.
#
# Pooled connection string — used by the application at runtime.
DATABASE_URL=postgresql://tip_app:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct (unpooled) connection — used only for migrations and seeding.
DATABASE_URL_UNPOOLED=postgresql://tip_app:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Owner connection. LOCAL ONLY — do not set this in Vercel. Used exclusively by
# `npm run db:migrate` and `npm run db:setup-role` for DDL.
DATABASE_URL_OWNER=postgresql://OWNER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# --- Authentication --------------------------------------------------
# At least 32 characters. Generate with:  openssl rand -base64 48
AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# --- Cloudflare R2 (S3-compatible API) -------------------------------
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=REPLACE_WITH_BUCKET_NAME
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY

# --- AI --------------------------------------------------------------
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# --- Background worker -----------------------------------------------
AI_WORKER_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX
# Vercel does NOT generate this for you. Set it yourself in the project's
# environment variables; Vercel Cron then sends it as `Authorization: Bearer
# <CRON_SECRET>` on every scheduled invocation. Leave it unset and the
# scheduled run has no secret to present.
CRON_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX

# --- Seeding (scripts only, never needed at runtime) ------------------
SEED_PASSWORD_CANDIDATE=REPLACE_FOR_LOCAL_SEEDING
SEED_PASSWORD_RECRUITER=REPLACE_FOR_LOCAL_SEEDING
SEED_PASSWORD_ADMIN=REPLACE_FOR_LOCAL_SEEDING
